	"authors": [
		"Armaninyow"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/total-yield",
		"sources": "https://github.com/armaninyow/Total-Yield",
		"issues": "https://github.com/armaninyow/Total-Yield/discussions/categories/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/totalyield/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.armaninyow.totalyield.TotalYield"
		],
		"modmenu": [
			"com.armaninyow.totalyield.TotalYieldModMenu"
		]
	},
	"mixins": [
		"totalyield.mixins.json"
	],
	"depends": {
